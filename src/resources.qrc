    <qresource prefix="/">
        <file alias="Main.qml">Main.qml</file>
        <file alias="GrowingPlant.qml">GrowingPlant.qml</file>
        <file alias="SkyBackdrop.qml">SkyBackdrop.qml</file>
        <file alias="Clouds.qml">Clouds.qml</file>
        <file alias="CloudShape.qml">CloudShape.qml</file>
        <file alias="Plane.qml">Plane.qml</file>
        <file alias="SoftGlow.qml">SoftGlow.qml</file>
        <file alias="Train.qml">Train.qml</file>
        <file alias="GardenView.qml">GardenView.qml</file>
        <file alias="Precipitation.qml">Precipitation.qml</file>
        <file alias="images/rain.png">images/rain.png</file>
        <file alias="images/snow.png">images/snow.png</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/da.json">i18n/da.json</file>
        <file alias="i18n/de.json">i18n/de.json</file>
        <file alias="i18n/es-MX.json">i18n/es-MX.json</file>
        <file alias="i18n/fr.json">i18n/fr.json</file>
        <file alias="i18n/pt-BR.json">i18n/pt-BR.json</file>
        <file alias="i18n/ja.json">i18n/ja.json</file>
    </qresource>
</RCC>
