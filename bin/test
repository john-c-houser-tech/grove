#!/bin/sh
# The unit tests, and the scene tests: the whole app with its real window,
# driven by keys. Nothing is shown on the desktop: the scene tests keep
# themselves offscreen however they are started. Arguments go to cargo test,
# as in: bin/test --test scene -- frames_for_review
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

exec cargo test --locked "$@"
