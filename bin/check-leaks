#!/bin/sh
# The memory gate, in two parts:
#
# 1. The tests, unmodified, under Valgrind: the unit tests of everything
#    that touches Qt (src/qml/, where the unsafe code that touches Qt is),
#    and the whole app
#    driven offscreen by the scene tests. Any definite or indirect leak or
#    memory error fails. The scene tests draw with Qt's software renderer
#    here, because under Valgrind the GPU driver is slow and reports noise of
#    its own; Grove's code runs the same. tests/valgrind.supp holds the one
#    report of Qt's that is wrong. The rest of the unit tests are safe Rust,
#    which the compiler has already checked for what Valgrind looks for, and
#    several of them time things, which Valgrind slows past their limits.
# 2. The soak test on a normal build: memory that stays referenced but is
#    never let go escapes Valgrind, so the heap is read after each of forty
#    rounds of each part of a day, and must not keep rising.
#
# The C++ Grove also ran its tests under the compilers' sanitizers. Rust has
# those only in its nightly toolchain, so they are not part of this gate.
#
#   bin/check-leaks           the check
#   bin/check-leaks --canary  proves the check works: plants a leak in a unit
#                             test, and keeps memory in the soak test, and
#                             passes only if both parts catch them
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Cargo builds into the repository's own target/, which the rest of this
# script reads from, whatever the environment says elsewhere.
export CARGO_TARGET_DIR="$ROOT/target"
cd "$ROOT"
canary=0
[ "${1:-}" = "--canary" ] && canary=1

if ! command -v valgrind >/dev/null; then
    echo "valgrind: not installed, and the memory gate needs it (sudo pacman -S valgrind)"
    exit 1
fi

# The desktop's own Qt plugins (the GTK theme, the input method) hold font
# caches for the life of the process. They are not part of Grove and would
# bury its results, so they are not loaded.
unset QT_QPA_PLATFORMTHEME QT_IM_MODULE QT_STYLE_OVERRIDE
export QT_QPA_PLATFORM=offscreen

# The test program cargo builds for a target, by the line cargo names it on.
logs="$ROOT/target/check-leaks"
mkdir -p "$logs"
program() {
    if ! cargo test --locked --no-run "$@" >"$logs/build.log" 2>&1; then
        cat "$logs/build.log" >&2
        return 1
    fi
    sed -n 's/.*Executable .*(\(.*\))$/\1/p' "$logs/build.log" | tail -1
}
unit="$(program --lib)" || { echo "the unit tests were not built"; exit 1; }
scene="$(program --test scene)" || { echo "the scene tests were not built"; exit 1; }
[ -x "$unit" ] && [ -x "$scene" ] || { echo "the test programs were not found"; exit 1; }

# A run that ran no tests has checked nothing, whatever it exits with.
ran() {
    grep -qE "$1" "$2" || { echo "$3: no tests ran, so nothing was checked"; exit 1; }
}

# Runs a test program under Valgrind. $1 names the run; the rest is the
# program and its arguments.
memcheck() {
    name="$1"
    shift
    valgrind --suppressions="$ROOT/tests/valgrind.supp" \
        --leak-check=full --show-leak-kinds=definite,indirect --errors-for-leak-kinds=definite,indirect \
        --num-callers=30 --error-exitcode=1 --log-file="$logs/$name.valgrind" "$@" >"$logs/$name.tests" 2>&1
}

# What Valgrind found in a run, if anything.
findings() {
    grep -E -B2 -A20 "are definitely lost|are indirectly lost|Invalid|uninitialised|Mismatched" "$logs/$1.valgrind" | head -60
    grep -E "ERROR SUMMARY" "$logs/$1.valgrind" || true
}

# 1. Valgrind.
if [ "$canary" = 1 ]; then
    if GROVE_LEAK_CANARY=1 memcheck canary "$unit" --test-threads=1 leak_canary; then
        echo "canary: Valgrind did NOT catch the planted leak"
        exit 1
    fi
    if grep -q "leak_canary" "$logs/canary.valgrind"; then
        echo "canary: Valgrind caught the planted leak, in leak_canary"
    else
        echo "canary: Valgrind failed, but not on the planted leak:"
        findings canary
        exit 1
    fi
else
    failed=0
    if memcheck unit "$unit" --test-threads=1 qml::; then
        ran '^test result: ok\. [1-9]' "$logs/unit.tests" "valgrind, unit tests of src/qml"
        echo "valgrind, unit tests of src/qml: $(grep -E '^test result' "$logs/unit.tests")"
    else
        failed=1
        findings unit
        grep -E "^test result|FAILED|panicked" "$logs/unit.tests" || echo "valgrind, unit tests: did not finish"
    fi
    if QT_QUICK_BACKEND=software memcheck scene "$scene"; then
        ran '^scene tests: [1-9]' "$logs/scene.tests" "valgrind, scene tests"
        echo "valgrind, $(grep -E '^scene tests' "$logs/scene.tests")"
    else
        failed=1
        findings scene
        grep -E "^scene tests|FAILED|panicked" "$logs/scene.tests" || echo "valgrind, scene tests: did not finish"
    fi
    [ "$failed" = 0 ] && echo "valgrind: no leaks or memory errors"
fi

# 2. The soak test.
if [ "$canary" = 1 ]; then
    if GROVE_SOAK=1 GROVE_LEAK_CANARY=1 "$scene" soak_garden >"$logs/soak.tests" 2>&1; then
        echo "canary: the soak test did NOT catch memory kept each round"
        exit 1
    fi
    # Failing is not enough: it must have failed on the heap.
    if ! kept="$(grep -m1 -oE 'rising [0-9]+ bytes a round' "$logs/soak.tests")"; then
        echo "canary: the soak test failed, but not on the heap:"
        tail -20 "$logs/soak.tests"
        exit 1
    fi
    echo "canary: the soak test caught memory kept each round ($kept)"
    exit 0
fi
if GROVE_SOAK=1 "$scene" soak >"$logs/soak.tests" 2>&1; then
    ran '^scene tests: 3 passed' "$logs/soak.tests" "soak"
    grep -E "heap grew" "$logs/soak.tests" | sed 's/^/soak: /'
else
    failed=1
    grep -E "heap grew|FAILED|panicked|rising" "$logs/soak.tests"
fi
exit "$failed"
